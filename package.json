{
  "name": "dyg",
  "version": "1.0.0",
  "description": "DYG — Do Your Game. Score devs by archetype, build your dream team.",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.js",
    "preview": "npm run build && npm run start",
    "db:init": "psql dyg < server/db/schema.sql",
    "db:seed": "psql dyg < server/db/seed.sql",
    "db:reset": "psql dyg < server/db/schema.sql && psql dyg < server/db/seed.sql"
  },
  "keywords": [],
  "author": "Scory — 4Dayvelopment",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/jwt": "^10.0.0",
    "@fastify/oauth2": "^8.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^9.1.1",
    "dotenv": "^17.4.2",
    "fastify": "^5.8.5",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "three": "^0.184.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "vite": "^8.0.8"
  }
}
