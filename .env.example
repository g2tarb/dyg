# Database
DATABASE_URL=postgresql://localhost:5432/dyg

# GitHub Personal Access Token (for unauthenticated API calls)
GITHUB_PAT=your_github_personal_access_token

# Server
PORT=3001

# OAuth GitHub (https://github.com/settings/developers → New OAuth App)
# Callback URL: http://localhost:5173/auth/github/callback
GH_CLIENT_ID=your_github_client_id
GH_CLIENT_SECRET=your_github_client_secret

# JWT Secret (minimum 32 characters, generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=

# Encryption key for access tokens (64 hex chars = 32 bytes, generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
ENCRYPTION_KEY=

# Base URL (for OAuth callback redirect)
BASE_URL=http://localhost:5173
